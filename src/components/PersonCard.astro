---
export interface PersonCardProps {
    name: string;
    position: string;
    role: string;
    image?: string;
    website?: string;
    color?: string; // Used for background circle when no image
}

const { name, position, role, image, color, website } = Astro.props as PersonCardProps;
---

<div class="flex gap-4 items-center">
    {
        image ? (
            <img
                src={image}
                alt={name}
                class="w-20 h-20 rounded-full object-cover shrink-0"
            />
        ) : (
            <div
                class="w-20 h-20 rounded-full text-white grid place-items-center text-4xl font-light shrink-0"
                style={`background-color: ${color ?? "#D1D5DB"}`}
            >
                {name?.charAt(0)}
            </div>
        )
    }

    <div class="flex flex-col justify-center">
        <h3 class="font-semibold text-base">
            {website ? (
                <a href={website} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:decoration-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">{name}</a>
            ) : name}
        </h3>
        <p class="text-sm text-neutral-600 dark:text-neutral-400">{position}</p>
        <p class="text-sm text-neutral-500 dark:text-neutral-300">{role}</p>
    </div>
</div>
